# Copy this file to `.env` and adjust values for your environment.
# Never commit your real `.env` file.

# --- Database ---
DATABASE_URL=sqlite:///./apnoea.db

# --- Security / JWT ---
# Generate a strong random value, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_SECRET_KEY_IN_PRODUCTION_YEAH
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=600000

# --- CORS ---
# Comma-separated list of allowed origins, e.g.: https://myapp.com,https://admin.myapp.com
# Use * only for local development.
CORS_ORIGINS=*

# --- Data query limits ---
MAX_QUERY_LIMIT=5000
DEFAULT_QUERY_LIMIT=200
